DATABASE_URL="postgresql://postgres:admin123@localhost:5432/aims-pos-ims-db?schema=public"

# Secret used to sign login JWTs (POST /api/auth/login). Use a long random
# string in every environment; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- SMTP (Gmail) for low-stock and expiry email alerts ---
# 1. Go to https://myaccount.google.com/security  →  turn ON 2-Step Verification.
# 2. Then https://myaccount.google.com/apppasswords  →  create an App Password
#    named "AIMS POS" and paste the 16 characters (no spaces) into SMTP_PASS
#    below. Regular Gmail passwords are rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=REPLACE_WITH_16_CHAR_APP_PASSWORD

# Comma-separated list of recipients. Leave empty to disable alert emails.
ALERT_RECIPIENTS=your-address@gmail.com

# Optional overrides
EXPIRY_WARN_DAYS=30

# Daily digest schedule (node-cron syntax). Default: 08:00 every day.
DAILY_DIGEST_CRON=0 8 * * *
TZ=Asia/Manila

# --- Receipt printer (silent, no browser dialog) ---
# The backend prints straight to the receipt printer over the network (raw
# ESC/POS on port 9100 — the standard "JetDirect" protocol almost every
# thermal receipt printer supports over Ethernet/WiFi), so checkout never
# opens a print dialog. Leave unset to disable printing (checkout still
# succeeds; the print is just skipped and logged).
#   RECEIPT_PRINTER_INTERFACE=tcp://192.168.1.50:9100
# RECEIPT_PRINTER_TYPE selects the ESC/POS command set: epson (default,
# works with most generic/clone thermal printers), star, tanca, daruma, or
# brother — check your printer's manual if receipts print garbled.
RECEIPT_PRINTER_INTERFACE=
RECEIPT_PRINTER_TYPE=epson
